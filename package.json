{
  "name": "@bruneckel/nuxt-theme-transitions",
  "version": "0.2.2",
  "description": "Animated dark/light theme transitions for Nuxt using the View Transitions API",
  "author": "Bruno Neckel",
  "license": "MIT",
  "type": "module",
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bruneckel/nuxt-theme-transitions.git"
  },
  "bugs": {
    "url": "https://github.com/bruneckel/nuxt-theme-transitions/issues"
  },
  "homepage": "https://github.com/bruneckel/nuxt-theme-transitions#readme",
  "peerDependencies": {
    "nuxt": ">=4.0.0"
  },
  "dependencies": {
    "@nuxt/kit": "^4.0.0"
  },
  "devDependencies": {
    "@nuxt/cli": "^3.37.0",
    "@nuxt/module-builder": "^1.0.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.8.0",
    "nuxt": "^4.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vue": "^3.5.40"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "prepack": "nuxt-module-build build",
    "lint": "eslint ."
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "theme",
    "dark-mode",
    "color-mode",
    "view-transitions",
    "spread",
    "fade",
    "transition",
    "animation"
  ]
}
